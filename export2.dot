    try {
        handler.handle(exchange);
    } catch (Exception e) {
        try {
            send(exchange, 500, \"{\\\"error\\\":\\\"internal error\\\"}\", \"application/json\");
        } catch (IOException ignored) {
        }
    } finally {
        exchange.close();
    }
